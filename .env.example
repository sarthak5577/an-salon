# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control

# ── Database Configuration ──────────────────────────────────────────────────
# Option A (Local SQLite - default): Leave TURSO_DATABASE_URL empty
DATABASE_PATH=./data/ansalon.db

# Option B (Turso Cloud SQLite - recommended for Render Free tier):
# TURSO_DATABASE_URL=libsql://your-db-name-yourusername.turso.io
# TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# ── Security & Authentication ──────────────────────────────────────────────
# JWT secret – minimum 64 characters
JWT_SECRET=replace_with_a_long_random_string_minimum_64_chars

# Session cookie name
SESSION_COOKIE_NAME=ansalon_session

# Set to production when deploying
NODE_ENV=development
